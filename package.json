{
  "name": "ultimate-hermes",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Hermes Agent local daily-life memory system",
  "bin": {
    "hermes": "./dist/src/cli/index.js",
    "ultimate-hermes-mcp": "./dist/src/mcp/server.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "clean": "rm -rf dist coverage",
    "cli": "node dist/src/cli/index.js",
    "dev:cli": "tsx src/cli/index.ts",
    "dev": "tsx watch src/server/index.ts",
    "start": "node dist/src/server/index.js",
    "test": "vitest run",
    "test:life-archive": "python3 -m unittest discover -s tests/life_archive",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "db:migrate": "npm run build && node dist/src/cli/index.js migrate",
    "setup:check": "npm run build && node dist/src/cli/index.js setup check",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f hermes"
  },
  "dependencies": {
    "commander": "^12.1.0",
    "dotenv": "^16.4.7",
    "drizzle-orm": "^0.45.2",
    "express": "^4.21.2",
    "pg": "^8.13.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.2",
    "@types/pg": "^8.11.10",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "engines": {
    "node": ">=22"
  }
}
