# Copy to .env for local runs. Do not put API secrets here.
HERMES_DATABASE_URL=postgres://hermes:hermes@localhost:55432/hermes
HERMES_PORT=8787
HERMES_HOST=127.0.0.1
HERMES_DATA_DIR=.hermes
HERMES_EMBEDDING_PROVIDER=local
HERMES_EMBEDDING_DIMENSIONS=1536

# macOS Keychain service/account references.
HERMES_LINEAR_KEYCHAIN_SERVICE=hermes-linear
HERMES_LINEAR_KEYCHAIN_ACCOUNT=default
HERMES_NOTION_KEYCHAIN_SERVICE=hermes-notion
HERMES_NOTION_KEYCHAIN_ACCOUNT=default
HERMES_GOOGLE_CLIENT_KEYCHAIN_SERVICE=hermes-google-client
HERMES_GOOGLE_CLIENT_ID_ACCOUNT=client-id
HERMES_GOOGLE_CLIENT_SECRET_ACCOUNT=client-secret
HERMES_GOOGLE_TOKEN_KEYCHAIN_SERVICE=hermes-google-token
HERMES_GOOGLE_TOKEN_ACCOUNT=default
HERMES_EMBEDDING_KEYCHAIN_SERVICE=hermes-embedding
HERMES_EMBEDDING_KEYCHAIN_ACCOUNT=default

# Optional HTTP embedding provider when HERMES_EMBEDDING_PROVIDER=http.
HERMES_EMBEDDING_URL=https://api.openai.com/v1/embeddings
HERMES_EMBEDDING_MODEL=text-embedding-3-small
