# Local development database. Never commit a real Supabase password.
HERMES_DATABASE_URL=postgres://hermes:hermes@127.0.0.1:55432/hermes

# Optional separate direct/session-pooler URL for schema migrations.
# HERMES_MIGRATION_DATABASE_URL=postgresql://postgres.PROJECT_REF:CHANGE_ME@REGION.pooler.supabase.com:5432/postgres?sslmode=require

HERMES_HOST=127.0.0.1
HERMES_PORT=8787
HERMES_PUBLIC_BASE_URL=http://127.0.0.1:8787

# Bootstrap/rollout administrator token. Generate with:
# openssl rand -hex 32
# Legacy authentication is disabled when this variable is omitted. Set it to true
# only for initial bootstrap, then restore false after a manager client works.
HERMES_API_TOKEN=replace-with-a-random-token
HERMES_ACCEPT_LEGACY_API_TOKEN=true

HERMES_SECRET_STORE=env
HERMES_ALLOW_REMOTE_WRITES=false
HERMES_ENABLE_LEGACY_ROUTES=false
HERMES_ALLOWED_HOSTS=localhost,127.0.0.1
HERMES_ALLOWED_ORIGINS=

HERMES_DATABASE_MAX_CONNECTIONS=5
HERMES_DATABASE_CONNECTION_TIMEOUT_MS=10000
HERMES_DATABASE_IDLE_TIMEOUT_MS=30000

# Set to http only after adding HERMES_EMBEDDING_API_KEY or OPENAI_API_KEY.
HERMES_EMBEDDING_PROVIDER=disabled
HERMES_EMBEDDING_MODEL=text-embedding-3-small
HERMES_EMBEDDING_DIMENSIONS=1536
HERMES_EMBED_LEGAL_SENSITIVE=false
# HERMES_EMBEDDING_API_KEY=
